// ------------------------------------------------------------------
// NOVA — Prisma schema
// Multi-tenant: every business record belongs to exactly one Workspace.
// Authorization is enforced server-side; clients never supply workspaceId.
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------- enums -----------------------------

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum BusinessType {
  FREELANCER
  AGENCY
  CONSULTANT
  SMALL_BUSINESS
  OTHER
}

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  OTHER
}

enum ActivityKind {
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_COMPLETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_SENT
  INVOICE_PAID
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  AI_ACTION
  MEMBER_JOINED
}

enum NotificationKind {
  INVOICE_OVERDUE
  INVOICE_PAID
  PAYMENT_RECEIVED
  TASK_DUE
  PROJECT_DEADLINE
  CLIENT_CREATED
  SYSTEM
}

// ------------------------------- models ----------------------------

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  phone         String?
  image         String?
  passwordHash  String?
  // Bumped on password change so previously issued JWTs are invalidated.
  tokenVersion  Int                 @default(0)
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  verificationCodes VerificationCode[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VerificationCode {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // "EMAIL" | "PHONE"
  destination String   // email address or phone number (E.164)
  codeHash    String   // SHA-256 hash of the 6-digit code
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pending signup data — stored when no User record exists yet.
  // Populated during registration; consumed when OTP is verified.
  pendingName         String?
  pendingPasswordHash String?
  pendingMethod       String?  // "EMAIL" | "PHONE"

  @@index([userId, type])
  @@index([destination, type])
}

model Workspace {
  id                String              @id @default(cuid())
  name                 String
  businessType         BusinessType?
  businessTypeCustom   String?
  members              WorkspaceMember[]
  clients           Client[]
  projects          Project[]
  tasks             Task[]
  invoices          Invoice[]
  payments          Payment[]
  activities        Activity[]
  notifications     Notification[]
  conversations     AIConversation[]
  nextInvoiceNumber Int                 @default(1000)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model WorkspaceMember {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole   @default(MEMBER)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Client {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  company     String
  email       String?
  phone       String?
  status      ClientStatus    @default(ACTIVE)
  notes       String?         @db.Text
  projects    Project[]
  invoices    Invoice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, company])
  @@index([workspaceId, createdAt])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String?
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ON_TRACK)
  progress    Int           @default(0)
  budget      Decimal       @default(0) @db.Decimal(12, 2)
  spent       Decimal       @default(0) @db.Decimal(12, 2)
  deadline    DateTime?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, clientId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, createdAt])
}

model Invoice {
  id           String        @id @default(cuid())
  workspaceId  String
  clientId     String
  number       String
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime
  dueDate      DateTime
  currency     String        @default("USD")
  taxRate      Decimal       @default(0) @db.Decimal(5, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  note         String?       @db.Text
  sentAt       DateTime?
  paidAt       DateTime?
  overdueNotifiedAt DateTime?
  items        InvoiceItem[]
  payments     Payment[]
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, clientId])
  @@index([workspaceId, createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  workspaceId String
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(OTHER)
  paidAt      DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([invoiceId])
  @@index([workspaceId, paidAt])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  kind        ActivityKind
  text        String
  detail      String?
  clientId    String?
  projectId   String?
  invoiceId   String?
  taskId      String?
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  kind        NotificationKind
  title       String
  detail      String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, readAt])
  @@index([workspaceId, createdAt])
}

model AIConversation {
  id        String       @id @default(cuid())
  workspaceId String
  title     String?
  messages  AIMessage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" | "tool"
  content        String         @db.Text
  toolName       String?
  toolCallId     String?
  toolArguments  Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
