# ------------------------------------------------------------------
# NOVA — environment variables
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to version control.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) -----------------------------------------
# Local Postgres example. Use your managed provider URL in production
# (Vercel Postgres / Neon / Supabase / RDS).
DATABASE_URL="postgresql://user:password@localhost:5432/nova?schema=public"

# --- Authentication (Auth.js) --------------------------------------
# Generate with: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-production-secret"
# Required for production deployments.
# AUTH_URL="https://your-app.vercel.app"

# --- Google OAuth ---------------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI ---------------------------------------------------------------
# Either provider enables the assistant. Gemini wins when both are set.
# Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override the default model. Free-tier note: gemini-3.5-flash and
# gemini-3.7-flash each have their own 20 req/min quota, so the 3.7 default
# keeps the app usable even when 3.5 is exhausted.
GEMINI_MODEL="gemini-3.7-flash"

# OpenAI: get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional: override the default model (e.g. "gpt-4o-mini")
OPENAI_MODEL="gpt-4o-mini"

# --- AI rate limiting & cost protection -------------------------------
# Per-workspace limits for the AI assistant endpoints (/api/ai/chat and
# /api/ai/confirm). When exceeded the API returns HTTP 429.
#
# NOTE: the limiter is an in-process Map (lib/rate-limit.ts) — fine for a
# single instance. For horizontally-scaled production, wire a shared store
# (e.g. Redis) into lib/rate-limit.ts before raising these values.
AI_RATE_LIMIT_REQUESTS=30          # /api/ai/chat requests per window per workspace
AI_CONFIRM_RATE_LIMIT_REQUESTS=10  # /api/ai/confirm requests per window per workspace
AI_RATE_LIMIT_WINDOW_MS=60000      # window for the two limits above (milliseconds)

# Agent loop / token caps. Bounds the number of model calls per request and
# the per-call output tokens so a single request cannot run away in cost.
AI_MAX_AGENT_STEPS=6       # max tool-call iterations per chat request
AI_MAX_OUTPUT_TOKENS=2048  # max_tokens on each model call
AI_MAX_HISTORY_MESSAGES=20 # most recent conversation messages fed to the model

# --- Email (Resend) -------------------------------------------------
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender domain or address. Must match a Resend-approved sender.
EMAIL_FROM="NOVA <no-reply@your-domain.com>"

# --- Storage (S3-compatible) ----------------------------------------
# Used for invoice PDFs and file uploads.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="nova-invoices"
S3_REGION="auto"

# --- Rate limiting ---------------------------------------------------
# In-memory (per-instance). For multi-instance production, wire a Redis
# URL here or replace lib/rate-limit.ts.
RATE_LIMIT_STORE="memory"

# --- Login / sign-up rate limits --------------------------------------
# Per-IP limits, enforced in the credentials authorize() before the bcrypt
# compare, plus on the register and reset-password endpoints.
LOGIN_RATE_LIMIT_ATTEMPTS=10  # max login attempts per window per IP
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# --- Misc ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
